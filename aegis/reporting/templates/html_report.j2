<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Aegis AI Report - {{ meta.session_id }}</title>
    <style>
        body { font-family: system-ui, sans-serif; max-width: 1100px; margin: 0 auto; padding: 2rem; background: #0f1117; color: #e6e6e6; }
        h1 { color: #00d4ff; border-bottom: 2px solid #00d4ff; padding-bottom: 0.5rem; }
        h2 { color: #a0d8ef; margin-top: 2rem; }
        h3 { color: #ccc; }
        table { width: 100%; border-collapse: collapse; margin: 1rem 0; }
        th { background: #1e2230; color: #00d4ff; padding: 0.6rem 1rem; text-align: left; }
        td { padding: 0.5rem 1rem; border-bottom: 1px solid #2a2f45; }
        tr:hover td { background: #1a1f2e; }
        .badge-fail { background: #c0392b; color: white; padding: 2px 8px; border-radius: 4px; font-size: 0.85em; }
        .badge-warn { background: #d68910; color: white; padding: 2px 8px; border-radius: 4px; font-size: 0.85em; }
        .badge-pass { background: #1e8449; color: white; padding: 2px 8px; border-radius: 4px; font-size: 0.85em; }
        .risk-critical { color: #e74c3c; font-weight: bold; }
        .risk-high { color: #e67e22; font-weight: bold; }
        .risk-medium { color: #f1c40f; font-weight: bold; }
        .risk-low { color: #2ecc71; font-weight: bold; }
        pre { background: #1a1f2e; padding: 1rem; border-radius: 6px; overflow-x: auto; font-size: 0.85em; white-space: pre-wrap; }
        .finding { background: #131720; border-left: 4px solid #2a2f45; padding: 1rem; margin: 1rem 0; border-radius: 4px; }
        .finding.fail { border-color: #c0392b; }
        .finding.warn { border-color: #d68910; }
        .finding.pass { border-color: #1e8449; }
        .meta-box { background: #1e2230; padding: 1rem; border-radius: 6px; display: grid; grid-template-columns: 1fr 1fr; gap: 0.5rem; }
        .rec-list li { margin: 0.5rem 0; color: #a8c; }
        footer { margin-top: 3rem; text-align: center; color: #555; font-size: 0.85em; }
    </style>
</head>
<body>

<h1>🛡️ Aegis AI Red-Team Report</h1>

<div class="meta-box">
    <div><strong>Session ID:</strong> <code>{{ meta.session_id }}</code></div>
    <div><strong>Generated:</strong> {{ meta.generated_at }}</div>
    <div><strong>Tool:</strong> {{ meta.tool }} {{ meta.version }}</div>
    <div><strong>Model:</strong> {{ target.provider }} / {{ target.model }}</div>
</div>

<h2>Executive Summary</h2>
<p>{{ executive_summary }}</p>

<h2>Risk Assessment</h2>
<table>
    <tr><th>Score</th><th>Level</th><th>Description</th></tr>
    <tr>
        <td><strong>{{ "%.1f"|format(risk.score) }} / 100</strong></td>
        <td><span class="risk-{{ risk.level | lower }}">{{ risk.level }}</span></td>
        <td>{{ risk.description }}</td>
    </tr>
</table>

<h2>Statistics</h2>
<table>
    <tr><th>Metric</th><th>Value</th></tr>
    <tr><td>Total Attacks</td><td>{{ statistics.total_attacks }}</td></tr>
    <tr><td>✅ Passed</td><td>{{ statistics.passed }}</td></tr>
    <tr><td>⚠️ Warnings</td><td>{{ statistics.warnings }}</td></tr>
    <tr><td>❌ Failed</td><td>{{ statistics.failed }}</td></tr>
    <tr><td>Total Tokens</td><td>{{ token_usage.total_tokens }}</td></tr>
    <tr><td>Estimated Cost</td><td>${{ "%.4f"|format(estimated_cost) }}</td></tr>
</table>

<h2>OWASP LLM Top 10 Mapping</h2>
{% if owasp_mapping %}
<table>
    <tr><th>ID</th><th>Category</th><th>Failures</th><th>Warnings</th><th>Passes</th></tr>
    {% for owasp_id, info in owasp_mapping.items() %}
    <tr>
        <td><strong>{{ owasp_id }}</strong></td>
        <td>{{ info.name }}</td>
        <td style="color:#e74c3c">{{ info.failures }}</td>
        <td style="color:#f1c40f">{{ info.warnings }}</td>
        <td style="color:#2ecc71">{{ info.passes }}</td>
    </tr>
    {% endfor %}
</table>
{% else %}
<p><em>No OWASP findings recorded.</em></p>
{% endif %}

<h2>Findings</h2>

{% for finding in findings %}
<div class="finding {{ finding.validation_status | lower }}{% if finding.validation_status == 'WARNING' %}warn{% endif %}">
    <h3>
        {% if finding.validation_status == 'FAIL' %}<span class="badge-fail">FAIL</span>
        {% elif finding.validation_status == 'WARNING' %}<span class="badge-warn">WARN</span>
        {% else %}<span class="badge-pass">PASS</span>{% endif %}
        <code>{{ finding.attack_id }}</code>
    </h3>
    <p><strong>Category:</strong> {{ finding.category }} &nbsp;|&nbsp;
       <strong>Agent:</strong> {{ finding.agent }} &nbsp;|&nbsp;
       <strong>Confidence:</strong> {{ (finding.confidence * 100)|int }}% &nbsp;|&nbsp;
       <strong>OWASP:</strong> {{ finding.owasp | join(', ') if finding.owasp else 'N/A' }}</p>
    <p><strong>Evidence:</strong> {{ finding.evidence or 'None detected.' }}</p>
    <details>
        <summary>Prompt / Response Transcript</summary>
        <p><strong>Prompt:</strong></p>
        <pre>{{ finding.prompt }}</pre>
        <p><strong>Response:</strong></p>
        <pre>{{ finding.response[:800] }}</pre>
    </details>
</div>
{% endfor %}

<h2>Recommendations</h2>
<ul class="rec-list">
{% for rec in recommendations %}
    <li>{{ rec }}</li>
{% endfor %}
</ul>

<footer>
    Report generated by <strong>Aegis AI</strong> v{{ meta.version }} &mdash;
    For authorised security testing only.
</footer>

</body>
</html>
